# Copy to .env (same folder) and fill in. Never commit .env.

# ---- Caddy -------------------------------------------------------------------------------------------------
# Public hostname. Needs a DNS A (and optionally AAAA) record pointing at this VM before first start,
# so Caddy can obtain the Let's Encrypt certificate.
AGERE_DOMAIN=agere.example.com

# ---- Agere service -----------------------------------------------------------------------------------------
# Public base URL as users see it (used for links and cookie/origin checks).
AGERE_PUBLIC_URL=https://agere.example.com

# Fernet key that encrypts stored warehouse credentials. REQUIRED. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every stored credential unreadable; changing it requires re-entering credentials (see DEPLOY.md).
AGERE_SECRET_KEY=

# Session cookies get the Secure flag. Keep 1 behind Caddy/HTTPS. Set 0 only for plain-HTTP local testing.
AGERE_COOKIE_SECURE=1

# Existing signed-in Claude subscription transport. No external Anthropic API key.
# The current container does not bundle an authenticated Claude CLI; provider
# operation there is an explicit deployment dependency, not a working default.
AGERE_CLAUDE_TRANSPORT=subscription

# Optional: internal URL of a demo stack to expose under /demo/* (for example http://demo:8000). Leave empty to disable.
AGERE_DEMO_UPSTREAM=

# Optional: the terminology encoder needs local model weights that are not in the image; "off" uses the
# lexical matcher directly (the image defaults to off).
AGERE_TERMINOLOGY_ENCODER=off

# Set by docker-compose.yml / the image; listed here for completeness. Do not change unless you know why.
# AGERE_DATA_DIR=/data
# AGERE_HOST=0.0.0.0
# AGERE_PORT=8080

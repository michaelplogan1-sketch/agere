 "barrier_policy": {
  "notes": "How documented therapy barriers (therapy_barrier, clinical/therapy_barriers.py) change a GDMT plan (plans/barriers.py). Scope: a barrier excludes only the agent it names (drug_key), or its class when no agent is named; a pillar is explained (closed) only when every agent in it is excluded or the barrier type explains the whole pillar. Recency: a barrier counts when its event_date, or a later restatement (last_date), falls within the window before as_of; older barriers are carried as history (stale_barrier) and never close a gap. Every applicable barrier on a missing pillar routes the patient to PharmD barrier review.",
  "recency_days": {
   "default": 1095,
   "contraindication_lab": 365,
   "contraindication_vitals": 365
  },
  "min_confidence": 0.7,
  "pillar_explaining_types": [
   "patient_declined",
   "not_indicated",
   "contraindication_lab",
   "contraindication_vitals"
  ],
  "class_wide_types": [
   "contraindication_lab",
   "contraindication_vitals",
   "patient_declined",
   "not_indicated"
  ],
  "cross_class_flags": [
   {
    "if_class": "ace_inhibitor",
    "barrier_types": [
     "allergy_angioedema"
    ],
    "exclude_classes": [
     "ace_inhibitor"
    ],
    "flag_classes": [
     "arni"
    ],
    "flag": "history of ACE-inhibitor angioedema: sacubitril/valsartan is contraindicated; an ARB needs caution and clinician review"
   },
   {
    "if_class": "arni",
    "barrier_types": [
     "allergy_angioedema"
    ],
    "exclude_classes": [
     "arni",
     "ace_inhibitor"
    ],
    "flag_classes": [
     "arb"
    ],
    "flag": "angioedema on sacubitril/valsartan: avoid ACE inhibitors; an ARB needs caution and clinician review"
   }
  ],

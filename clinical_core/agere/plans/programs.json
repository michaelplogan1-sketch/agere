    "detail": "program denied eligibility; route to an alternate program of the same kind or care-team review"
   },
   "coverage_denied": {
    "type": "alternate_program",
    "owner": "care_team",
    "due_days": 7,
    "detail": "coverage / benefit denied; alternate program, financial counseling or coverage verification"
   },
   "prior_auth_denied": {

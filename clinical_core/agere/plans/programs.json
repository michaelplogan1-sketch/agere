    "detail": "prior authorization denied; appeal with supporting documentation"
   },
   "appeal_upheld": {
    "type": "alternate_program",
    "owner": "care_team",
    "due_days": 7,
    "detail": "appeal upheld; alternate program or self-directed plan"
   },
   "dropped_after_no_show": {

{
 "schema": "tiered-readmission-review/1",
 "authored": "2026-11-14",
 "authored_by": "Claude (build owner)",
 "question": "Review the readmission of patient {patient} on {readmit_admit}: why were they readmitted, what did the chart say, did they get follow-up, what are their risk factors, are there advance directives, and what do the labs and imaging show?",
 "selection": "The twelve readmitted patients (inpatient stay beginning 1 to 30 days after an earlier inpatient discharge) whose charts hold the most kinds of information: labs during the readmission, a visit and an appointment between the stays, four or more documents in the window, more than one chronic condition, a positive social-need screen. Ranked by how many of those six they have. Chosen by that rule before either arm ran. This favours full charts on purpose: a review of an empty chart tests nothing.",
 "reference": "Reasons and the follow-up instruction: read by the build owner in the discharge summary of each stay. Follow-up visit, prior admissions, labs, advance-directive wording and social needs: computed by queries written for this key, separately from the recipes the stack uses. Written and committed before the review path existed and before the chart reader ran on any of these patients.",
 "definitions": {
  "follow_up_visit_within_7_days": "a visit row dated after the prior discharge, within 7 days of it and before the readmission, of a type other than inpatient, emergency, observation, telephone or orders-only",
  "inpatient_admissions_in_prior_12_months": "distinct inpatient admission dates in the 365 days before the readmission admission date, not counting the readmission itself",
  "lab_concepts_resulted_during_readmission": "named lab or vital concepts with a result dated from the readmission admission through one day after its discharge",
  "advance_directive_documented": "any document of the patient contains advance directive, POLST/MOLST, DNR/DNI, code status, full code, health care proxy, living will, goals of care, power of attorney, comfort care, hospice or palliative"
 },
 "rule": "Eight items per patient, each right or wrong: readmission reason (a supported quote containing the phrase, from the accepted document); prior-stay reason (same); follow-up instruction (a supported quote from the prior discharge summary that contains the words follow up); follow-up visit within 7 days (yes/no); days between discharge and readmission; inpatient admissions in the prior 12 months; whether any lab resulted during the readmission (yes/no); whether an advance directive is documented (yes/no). The chart reader is given the same definitions and the same structured rows. This is not a test of any product.",
